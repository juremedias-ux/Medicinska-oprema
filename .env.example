# ---------------------------------------------------------------------------
# Medcore — okoljske spremenljivke
# Kopirajte to datoteko v .env.local in vpišite vrednosti iz projekta Supabase
# (Project Settings → API). Datoteka .env.local se ne shranjuje v Git.
# ---------------------------------------------------------------------------

# URL projekta Supabase, npr. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Javni ključ (anon / publishable). Zaščito podatkov zagotavlja Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Neobvezno: kanonični URL spletne strani (za SEO, sitemap in Open Graph).
# Na Vercelu se brez te spremenljivke samodejno uporabi produkcijska domena projekta.
# NEXT_PUBLIC_SITE_URL=https://www.medcore.si
